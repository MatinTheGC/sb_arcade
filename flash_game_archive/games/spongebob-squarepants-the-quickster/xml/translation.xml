<?xml version="1.0" encoding="utf-8" ?>
<!--<translation attributes>-->
<!-- defaultFont dictates the font (based on the id set in fonts.xml) that all fields will use unless fontId is specified within that field's tag-->
<!-- english, when set to TRUE, ignores all localization and uses the default field data in the FLA.-->

<!-- <Node Attributes> -->
<!-- fontSize is Optional. It allows you to customize the size of the font used in this particular field. Leave it out to use the defaul size in the FLA.-->
<!-- fontName is Optional. It allows you to customize the font used in this particular field. Leave it out to use the defaul font (specified by defaultFont).-->
<!-- id is not Optional. It determines where flash places the text.-->

<!-- <<<GHOSTLY GRAMMAR NOTES>>> : -->
<!-- the following three <string> elements should only contain dummy text for content (they will be cleared when the game starts), they are only used to change the font/font-size of the dynamic gameplay text-boxes : -->
<!-- "word_display_grid" : the font/fontSize of the text on the game grid -->
<!-- "word_display_hud" : the font/fontSize of the "rhymes with" level word in the gameplay HUD (on the right of the screen) -->
<!-- "word_display_popup" : the font/fontSize of the text on the pop-up screen that displays before each level -->
<!-- How to Localize Gameplay Words (xml/config.xml) : -->
<!-- The words used for gameplay are found in the config.xml. For each level, the game selects one 'pool' of rhyming words and one word from that pool as the "rhymes with" word. -->
<!-- The grid is populated with correct words (from the level word pool) + a random selection of words from all of the other word pools-->
<!-- Each <pool> element should contain a string of rhyming words separated by a comma (no spaces)
<!-- Word-pools that use non-Latin fonts must be formatted with the CDATA tag wrapping the entire string -->
<!-- (EXAMPLE USING Latin : <pool><![CDATA[?,?,?,?]]></pool>) -->
<!-- To avoid excessive repetition in levels, fill each pool with as many rhyming words as possible -->


