<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- Domains this application is intended to run on -->
	<allowedDomains>
		<allowedDomain>localhost</allowedDomain>
		<!--PLEASE USE FULL DOMAIN NAME NOT JUST "nick.com". 
		Anyone can steal the game and then add "something.nick.com" to the url
		which might make the site locking a "nice attempt".-->
		<allowedDomain>spongebob.nick.com</allowedDomain>
		<allowedDomain>nick.com</allowedDomain>
		<allowedDomain>mtvi.com</allowedDomain>
		<allowedDomain>mtvnimages.com</allowedDomain>
		<allowedDomain>file</allowedDomain>
	</allowedDomains>
	<!--ServiceLocator url-->
	<urlNickServiceLocator>/common/flash/services/data/services.xml</urlNickServiceLocator>
	<!-- Used by nick services plugin -->
	<nickServicesSettings>
		<!--Enables/Disables the Nick Services such as Login, Leaderboards and Printables-->
		<enableNickServices>true</enableNickServices>
		<!--Enables/Disables the Special Code used to get a slight advantage in the game-->
		<enableSpecialCode>true</enableSpecialCode>
		<!--Not Applicable-->
		<enableUniversalEndGameScreen>false</enableUniversalEndGameScreen>
	</nickServicesSettings>
	<!-- Nick Points -->
	<!-- moduleSwfUrl should only be used if specifically directed. Otherwise leave it empty.-->
	<nickPoints moduleSwfUrl="">
		<campaignName>NICKPOINTS_CAMPAIGN_NAME</campaignName> <!-- [TODO] Needs custom data -->
	</nickPoints>
	<!-- Nick Achievements --> <!-- Needs custom data -->
	<achievements gameId="ACHIEVEMENT_GAME_ID" urlBaseIcons="/nick-assets/achievements/images/supah-ninjas-true-ninja-test/" 
			urlUIPopup="components/achievement_popup.swf" urlUISummary="components/achievement_summary.swf" 
			popupAlignment="bottomleft" popupDuration="3" badgeAssetOffsetX="0" badgeAssetOffsetY="0">
		<!-- popupAlignment can be "top", "bottom", "topleft", "topright", "bottomleft", "bottomright" top and bottom are centered, left and right are in the top corners -->
		<!-- id is for local use only. You can call it whatever you want. The node value is the actual trigger that will be sent to nick.com services -->		
		<achievement>
			<id>MikeTest</id> <!-- The local reference ID to be used in-game for earning/testing. Any time you need to reference this badge in your game, use this id. Not supplied by Nick. -->
			<trigger>MikeTest</trigger> <!-- the actual trigger value that is sent by the API to nick.com servers. Supplied by Nick. -->
			<serverCode>supah-ninjas-true-ninja-test_game_green_10</serverCode><!-- This is the badge ID on the server side. It is needed by the API to verify that a badge has been earned. Supplied by Nick.  -->
			<nickPointEventName>badge-one</nickPointEventName> <!-- Valid settings are "badge-one", "badge-two", "badge-three", "badge-four", "badge-five" and "trophy". -->
			<title><![CDATA[Mike's Test]]></title> <!-- The title of the achievement for in-game display. -->
			<description><![CDATA[Throw One Ninja Star]]></description> <!-- The description of the achievement for in-game display. -->
			<dataType>Number</dataType> <!-- The type of data that will be sent with this achievement. Can be either "Number" or "String".  -->
			<urlIconEnabled>supah-ninjas-true-ninja-test_game_green_10.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
			<urlIconDisabled>supah-ninjas-true-ninja-test_game_green_10_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->	
		</achievement> 
		<achievement>
			<id>BADGE_LOCAL_ID_HERE</id> <!-- The local reference to be used in the game-->
            <trigger>BADGE_TRIGGER_HERE</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
