<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- Unlock Screen -->
	<unlock enabled="true">swag</unlock>
	<!-- Ad Interruption Functionality -->
	<adInterruption enabled="false">content/ad_animation/interruption.swf</adInterruption>
	<!-- External plugins to load -->
	<plugins enabled="true">
		<plugin id="leaderboard" enabled="true">plugins/plugin_nick_leaderboard.swf</plugin>
		<plugin id="services" enabled="true">plugins/plugin_nick_services.swf</plugin>
		<plugin id="localization" enabled="true">plugins/plugin_nick_localization.swf</plugin>
	</plugins>
	<!--ServiceLocator url-->
	<urlNickServiceLocator>common/flash/services/data/services.xml</urlNickServiceLocator>
	<!-- URL of Nick in-game notification API -->
	<nickServicesAPIAchievementsURL>games/data/awards/in-game-notifications/nick_services_achievements.swf</nickServicesAPIAchievementsURL>
	<!-- Used by Universal End Game Screen -->
	<nickUEGSSettings>
		<titleText>Second Hand Swag</titleText>
		<scoreText>Score</scoreText>
	</nickUEGSSettings>	
	<!-- Used by nick services plugin -->
	<nickServicesSettings>
		<enableLogin method="2">true</enableLogin> <!-- method "3" should always be used. -->
		<enableTracking method="0">true</enableTracking>
		<enableNickPoints>false</enableNickPoints>
		<enableAchievements>true</enableAchievements>		
		<enableClubItems>false</enableClubItems>
		<enableUniversalEndGameScreen>true</enableUniversalEndGameScreen>
		<enableLegacyServiceProxy url="plugins/legacy/nick_legacy_services.swf">true</enableLegacyServiceProxy> <!-- This is still necessary for leaderboards -->	
	</nickServicesSettings>		
	<!-- Domains this application is intended to run on -->
	<allowedDomains>
		<allowedDomain>workinman.com</allowedDomain>
		<allowedDomain>localhost</allowedDomain>
		<allowedDomain>nick.com</allowedDomain>
		<allowedDomain>mtvi.com</allowedDomain>
		<allowedDomain>mtvnimages.com</allowedDomain>
	</allowedDomains>
	<!-- Used by services plugin -->
	<tracking>	
		<tracking_legacy>
			<trackingPlayFunction>trackKidsGamePlay</trackingPlayFunction>
			<trackingPlayAgainFunction>trackKidsGamePlay</trackingPlayAgainFunction>
			<trackingPlayGameName>TRACKING_GAME_NAME_HERE</trackingPlayGameName> <!-- Needs custom data -->
			<trackingPrintFunction>printTracker</trackingPrintFunction>
			<trackingPrintSite>SITE_HERE</trackingPrintSite> <!-- Needs custom data -->
			<trackingPrintUrlAlias>PRINT_URL_ALIAS_HERE</trackingPrintUrlAlias> <!-- Needs custom data -->
			<trackingPrintContentType>game</trackingPrintContentType>
			<trackingPrintShowID>SHOW_ID_HERE</trackingPrintShowID> <!-- Needs custom data -->
		</tracking_legacy> 
		<tracking_2011>
			<trackingGameLoad>ON_GAME_LOAD</trackingGameLoad>
			<trackingGamePlay>ON_GAME_PLAY</trackingGamePlay>
			<trackingLevelStart>ON_GAME_LEVELSTART</trackingLevelStart>
		</tracking_2011>
	</tracking>	
	<!-- Used by leaderboard plugin -->
	<leaderboard>
		<gameId id="game">LEADERBOARD_GAME_ID</gameId> <!-- Needs custom data -->
	</leaderboard>
	<!-- Used by localization plugin. Technically all translationXml collections are tied to an appId. However if you leave the appId as "" and do the same in the app itself, it will treat it as a "generic" localization file. Convenient for fast/easy access. -->
	<localization>
		<fontFile>fonts/embeddedFonts.swf</fontFile>
		<fontXml>fonts/fonts.xml</fontXml>
		<translationXmls>
			<translationXml appId="">xml/translation.xml</translationXml>
		</translationXmls>
	</localization>
	<!-- External Files to load -->
	<file_collections>
		<collection id="initial">			
		</collection>		
	</file_collections>
	<!--Cutscene Engine-->
	<cutsceneEngine enabled="false" baseUrl="xml/cutscenes/">
		<characters>characters.xml</characters>
		<cutsceneCollections>
			<collection id="cutscene_collection_1">
				<file>cutscene_example1.xml</file>
			</collection>
		</cutsceneCollections>
	</cutsceneEngine>
	<!-- Printable -->
	<printable enabled="true" />	
	<!-- Nick Points -->
	<!-- moduleSwfUrl should only be used if specifically directed. Otherwise leave it empty.-->
	<nickPoints moduleSwfUrl="">
		<campaignName>NICKPOINTS_CAMPAIGN_NAME</campaignName> <!-- [TODO] Needs custom data -->
	</nickPoints>
	<!-- Nick Achievements --> <!-- Needs custom data -->
	<achievements gameId="spongebob-squarepants-second-hand-swag" urlBaseIcons="/nick-assets/achievements/images/spongebob-squarepants-second-hand-swag/" 
			urlUIPopup="components/achievement_popup.swf" urlUISummary="components/achievement_summary.swf" 
			popupAlignment="bottomleft" popupDuration="3" badgeAssetOffsetX="0" badgeAssetOffsetY="0">
		<!-- popupAlignment can be "top", "bottom", "topleft", "topright", "bottomleft", "bottomright" top and bottom are centered, left and right are in the top corners -->
		<!-- id is for local use only. You can call it whatever you want. The node value is the actual trigger that will be sent to nick.com services -->		
		<achievement>
			<id>CatchInJelly</id> <!-- The local reference to be used in the game-->
            <trigger>SlipperyScore</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_10</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-one</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Catch a trophy in jelly]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_10.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_10_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement>
		<achievement>
			<id>NoJelly</id> <!-- The local reference to be used in the game-->
            <trigger>AvoidTheGoo</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_20</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-two</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Make it to level 3 without stepping in jelly]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_20.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_20_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement> 
		<achievement>
			<id>NoDrop</id> <!-- The local reference to be used in the game-->
            <trigger>DontDropTheSwag</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_30</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-three</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Make it to level 4 without dropping a trophy]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_30.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_30_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement> 
		<achievement>
			<id>JumpCatch</id> <!-- The local reference to be used in the game-->
            <trigger>GrabTheGold</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_40</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-four</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Catch 10 consecutive trophies while jumping]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_40.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_40_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement> 
		<achievement>
			<id>StackTen</id> <!-- The local reference to be used in the game-->
            <trigger>DontTipTheTrophies</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_50</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-five</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Turn in a stack of 10 or more]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_50.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_50_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement>
		<achievement>
			<id>ComboMaster</id> <!-- The local reference to be used in the game-->
            <trigger>SwagMaster</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-second-hand-swag_100</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>trophy</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[badge title]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Score at least 15,000 points in a single combo]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-second-hand-swag_100.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-second-hand-swag_100_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement>  
	</achievements>
</config>