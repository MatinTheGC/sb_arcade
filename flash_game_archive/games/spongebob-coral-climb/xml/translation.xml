<?xml version="1.0" encoding="utf-8" ?>
<!--<translation attributes>-->
<!-- defaultFont dictates the font (based on the id set in fonts.xml) that all fields will use unless fontId is specified within that field's tag-->
<!-- english, when set to TRUE, ignores all localization and uses the default field data in the FLA.-->

<!-- <Node Attributes> -->
<!-- fontSize is Optional. It allows you to customize the size of the font used in this particular field. Leave it out to use the defaul size in the FLA.-->
<!-- fontName is Optional. It allows you to customize the font used in this particular field. Leave it out to use the defaul font (specified by defaultFont).-->
<!-- id is not Optional. It determines where flash places the text.-->
<strings defaultFont="Latin" english="true">
	<!--Preloader-->
	<string id="loading"	fontName="Latin"	fontSize="16"	><![CDATA[Loading]]></string>
	<!--Basics-->
	<string id="title"		fontName="Latin"	><![CDATA[CORAL CLIMB]]></string>	
	<string id="play_txt"		fontName="Latin"	fontSize="16"	><![CDATA[PLAY]]></string>
	<string id="txt_play_help"	fontName="Latin"	fontSize="16"><![CDATA[Play]]></string>
	<string id="play_again"	fontName="Latin"	fontSize="16"	><![CDATA[TRY AGAIN]]></string>	
	<string id="how_to_play"fontName="Latin"	fontSize="16"	><![CDATA[HOW TO PLAY]]></string>
	<string id="next"		fontName="Latin"	fontSize="16"	><![CDATA[NEXT]]></string>
	<string id="back"		fontName="Latin"	fontSize="16"	><![CDATA[BACK TO GAME]]></string>
	<string id="continue_txt"	fontName="Latin"	fontSize="16"	><![CDATA[CONTINUE]]></string>
	<string id="close"		fontName="Latin"	fontSize="16"	><![CDATA[CLOSE]]></string>
	<string id="printable"	fontName="Latin"	fontSize="16"	><![CDATA[PRINTABLE]]></string>
	<!--Game Buttons-->
	<string id="menu"		fontName="Latin"	fontSize="16"	><![CDATA[?]]></string>
	<string id="help"		fontName="Latin"	fontSize="16"	><![CDATA[HOW TO PLAY]]></string>
	<string id="sound_on"	fontName="Latin"	fontSize="16"	><![CDATA[SOUND ON]]></string>
	<string id="sound_off"	fontName="Latin"	fontSize="16"	><![CDATA[SOUND OFF]]></string>
	<string id="resume"		fontName="Latin"	fontSize="16"	><![CDATA[RESUME]]></string>
	<!--Quit-->
	<string id="quit"		fontName="Latin"	fontSize="16"	><![CDATA[QUIT]]></string>
	<string id="quit_confirm_header"	fontName="Latin"	fontSize="16"><![CDATA[ARE YOU SURE YOU WANT TO QUIT?]]></string>
	<string id="yes"		fontName="Latin"	fontSize="16"	><![CDATA[YES]]></string>
	<string id="no"			fontName="Latin"	fontSize="16"	><![CDATA[NO]]></string>
	<string id="dont"		fontName="Latin"	fontSize="16"	><![CDATA[DON'T GIVE UP!]]></string>
	<!--Gameplay-->
	<string id="level"		fontName="Latin"	fontSize="16"	><![CDATA[LEVEL]]></string>
	<string id="score"		fontName="Latin"	fontSize="16"	><![CDATA[SCORE:]]></string>	
	<string id="paused"		fontName="Latin"	fontSize="16"	><![CDATA[PAUSED]]></string>
	<string id="level_up"	fontName="Latin"	fontSize="16"	><![CDATA[LEVEL UP]]></string>
	<string id="game_over"	fontName="Latin"	fontSize="16"	><![CDATA[GAME OVER]]></string>	
	<!--Leaderboard-->
	<string id="you"		fontName="Latin"	fontSize="16"	><![CDATA[YOU: ]]></string>
	<string id="top"		fontName="Latin"	fontSize="16"	><![CDATA[TOP]]></string>	
	<string id="leaderboard"	fontName="Latin"	fontSize="16"><![CDATA[LEADERBOARD]]></string>
	<string id="submit_score"	fontName="Latin"	fontSize="16"><![CDATA[SUBMIT SCORE]]></string>	
	<!-- Copy/Body -->
	<string id="help_copy"	fontName="Latin"	fontSize="16"><![CDATA[HELP COPY]]></string>
	<string id="watch"		fontName="Latin"	fontSize="16"	><![CDATA[Watch 'Show Name' on]]></string>
	<!-- instructions -->
	<string id="instructions_title"		fontName="Latin"	fontSize="16"	><![CDATA[Instructions]]></string>
	<string id="instruction_body"		fontName="Latin"	fontSize="16"	><![CDATA[Use the Arrow Keys to guide SpongeBob through the labyrinth of Coral Springs.
Find the SUPER SPRINGS to level up! but watch out for those jellies!]]></string>
</strings>
