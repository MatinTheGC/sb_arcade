<?xml version="1.0" encoding="utf-8" ?>
<!--<translation attributes>-->
<!-- defaultFont dictates the font (based on the id set in fonts.xml) that all fields will use unless fontId is specified within that field's tag-->
<!-- english, when set to TRUE, ignores all localization and uses the default field data in the FLA.-->

<!-- <Node Attributes> -->
<!-- fontSize is Optional. It allows you to customize the size of the font used in this particular field. Leave it out to use the defaul size in the FLA.-->
<!-- fontName is Optional. It allows you to customize the font used in this particular field. Leave it out to use the defaul font (specified by defaultFont).-->
<!-- id is not Optional. It determines where flash places the text.-->
<strings defaultFont="NickFont" english="true">
	<!--Preloader-->
	<string id="loading"	fontName="NickFont"	fontSize="16"	><![CDATA[Loading]]></string>
	<!--Basics-->
	<string id="title"		fontName="NickFont"	><![CDATA[GAME NAME]]></string>	
	<string id="play"		fontName="NickFont"	fontSize="16"	><![CDATA[Play]]></string>
	<string id="play_again"	fontName="NickFont"	fontSize="16"	><![CDATA[Try Again]]></string>	
	<string id="how_to_play"fontName="NickFont"	fontSize="16"	><![CDATA[How to Play]]></string>
	<string id="next"		fontName="NickFont"	fontSize="16"	><![CDATA[Next]]></string>
	<string id="back"		fontName="NickFont"	fontSize="16"	><![CDATA[Back to Game]]></string>
	<string id="continue"	fontName="NickFont"	fontSize="16"	><![CDATA[Continue]]></string>
	<string id="close"		fontName="NickFont"	fontSize="16"	><![CDATA[close]]></string>
	<string id="printable"	fontName="NickFont"	fontSize="16"	><![CDATA[Printable]]></string>
