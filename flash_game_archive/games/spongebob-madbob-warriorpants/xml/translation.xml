	<string id="paused"		fontName="NickFont"	fontSize="16"	><![CDATA[Paused]]></string>
	<string id="level_up"	fontName="NickFont"	fontSize="16"	><![CDATA[Level Up]]></string>
	<string id="game_over"	fontName="NickFont"	fontSize="16"	><![CDATA[Game
Over]]></string>	
