- JUMP TO SLAM THE CREW MEMBERS OFF
- DODGE JUMPING CREW MEMBERS
- TRY TO GET AS FAR AS YOU CAN!!!]]></string>
	<!--Game Buttons-->
	<string id="menu"		fontName="NickFont"	fontSize="16"	><![CDATA[?]]></string>
	<string id="help"		fontName="NickFont"	fontSize="16"	><![CDATA[How to Play]]></string>
	<string id="sound_on"	fontName="NickFont"	fontSize="16"	><![CDATA[Sound On]]></string>
	<string id="sound_off"	fontName="NickFont"	fontSize="16"	><![CDATA[Sound Off]]></string>
	<string id="resume"		fontName="NickFont"	fontSize="16"	><![CDATA[Resume]]></string>
	<!--Quit-->
	<string id="quit"		fontName="NickFont"	fontSize="16"	><![CDATA[Quit]]></string>
