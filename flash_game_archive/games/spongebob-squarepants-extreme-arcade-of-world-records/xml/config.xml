<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- NICKELODEON TRACKABLES -->
	<playButton>
		<func>trackKidsGamePlay</func>
		<urlAlias>spongebob-squarepants-extreme-arcade-of-world-records</urlAlias>
	</playButton>
	<scoreTracking>
		<gameID>spongebob-do-not-remove</gameID>
		<chumID>spongebob-squarepants-buckets-of-chum-hsb</chumID>
		<chainsawID>spongebob-squarepants-chainsaw-juggler-hsb</chainsawID>
		<cobraID>spongebob-squarepants-cobra-milker-hsb</cobraID>
		<cardID>spongebob-squarepants-mansion-of-cards-hsb</cardID>
		<megabandID>spongebob-squarepants-mega-band-ball-hsb</megabandID>
		<tongueID>spongebob-squarepants-longest-tongue-hsb</tongueID>
	</scoreTracking>
	<printButton enabled="true">
		<func>KIDS.reporting.omnifunctions.printReporting</func>
		<division>nick</division>
		<urlAlias>spongebob-squarepants-extreme-arcade-of-world-records</urlAlias>
		<contentType>game</contentType>
		<showID>spongebob-squarepants-extreme-arcade-of-world-records</showID>
		<numPages>1</numPages>
	</printButton>
	<leaderBoard enabled="true" />
	
<!-- **START** Nickelodeon Framework Config Information -->

	<!-- Domains this application is intended to run on -->
	<allowedDomains>
		<allowedDomain>localhost</allowedDomain>
		<allowedDomain>nick.com</allowedDomain>
		<allowedDomain>mtvi.com</allowedDomain>
		<allowedDomain>mtvnimages.com</allowedDomain>
		<allowedDomain>seven2.com</allowedDomain>
		<allowedDomain>seven2.net</allowedDomain>
	</allowedDomains>
	<!--ServiceLocator url-->
	<urlNickServiceLocator>common/flash/services/data/services.xml</urlNickServiceLocator>
	<!-- Used by nick services plugin -->
	<nickServicesSettings>
		<enableLogin method="3">true</enableLogin> <!-- method "3" should always be used. -->
		<enableNickPoints>true</enableNickPoints>
		<enableAchievements>true</enableAchievements>
		<enableUniversalEndGameScreen>true</enableUniversalEndGameScreen>
		<enableAnalytics id="651577037274816645" >true</enableAnalytics>
	</nickServicesSettings>		
	<!-- Nick Points -->
	<!-- moduleSwfUrl should only be used if specifically directed. Otherwise leave it empty.-->
	<nickPoints moduleSwfUrl="">
		<campaignName>sb-arcade-badges</campaignName> <!-- [TODO] Needs custom data -->
	</nickPoints>
	<!-- Nick Achievements --> <!-- Needs custom data -->
	<achievements gameId="spongebob-squarepants-extreme-arcade-of-world-records" urlBaseIcons="/nick-assets/achievements/images/spongebob-squarepants-extreme-arcade-of-world-records/" 
			urlUIPopup="components/achievement_popup.swf" urlUISummary="components/achievement_summary.swf" 
			popupAlignment="bottomleft" popupDuration="3" badgeAssetOffsetX="0" badgeAssetOffsetY="0">
		<!-- popupAlignment can be "top", "bottom", "topleft", "topright", "bottomleft", "bottomright" top and bottom are centered, left and right are in the top corners -->
		<!-- id is for local use only. You can call it whatever you want. The node value is the actual trigger that will be sent to nick.com services -->
		<achievement>
			<id>badge-one</id> <!-- The local reference ID to be used in-game for earning/testing. Any time you need to reference this badge in your game, use this id. Not supplied by Nick. -->
			<trigger>BitOfAStretch</trigger> <!-- the actual trigger value that is sent by the API to nick.com servers. Supplied by Nick. -->
			<serverCode>spongebob-squarepants-extreme-arcade-of-world-records_game_10</serverCode><!-- This is the badge ID on the server side. It is needed by the API to verify that a badge has been earned. Supplied by Nick.  -->
			<nickPointEventName>badge-one</nickPointEventName> <!-- Valid settings are "badge-one", "badge-two", "badge-three", "badge-four", "badge-five" and "trophy". -->
			<title><![CDATA[Bit of a Stretch]]></title> <!-- The title of the achievement for in-game display. -->
			<description><![CDATA[Get a fair distance in Longest Tongue.]]></description> <!-- The description of the achievement for in-game display. -->
			<dataType>Number</dataType> <!-- The type of data that will be sent with this achievement. Can be either "Number" or "String".  -->
			<urlIconEnabled>spongebob-squarepants-extreme-arcade-of-world-records_game_10.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
			<urlIconDisabled>spongebob-squarepants-extreme-arcade-of-world-records_game_10_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->
		</achievement> 
		<achievement>
			<id>badge-two</id> <!-- The local reference to be used in the game-->
            <trigger>RaininChum</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-extreme-arcade-of-world-records_game_20</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
