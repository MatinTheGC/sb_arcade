            <title><![CDATA[Milkin' It!]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Milk a pretty good amount from cobras in Cobra Milker.]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-extreme-arcade-of-world-records_game_30.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-extreme-arcade-of-world-records_game_30_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->
		</achievement> 
		<achievement>
			<id>badge-four</id> <!-- The local reference to be used in the game-->
            <trigger>OffTheChainsaw</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-extreme-arcade-of-world-records_game_40</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
