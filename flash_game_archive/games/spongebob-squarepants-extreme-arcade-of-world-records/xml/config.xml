            <description><![CDATA[Catch a good amount of chum in Buckets of Chum.]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-extreme-arcade-of-world-records_game_20.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-extreme-arcade-of-world-records_game_20_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon --> 
		</achievement> 
