            <urlIconDisabled>spongebob-squarepants-showtime-squirrel_30_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement> 
		<achievement>
			<id>BADGE_4</id> <!-- The local reference to be used in the game-->
            <trigger>CantStopThisGirlSquirrel</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-showtime-squirrel_40</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
