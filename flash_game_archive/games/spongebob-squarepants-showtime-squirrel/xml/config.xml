            <urlIconDisabled>spongebob-squarepants-showtime-squirrel_40_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement> 
		<achievement>
			<id>BADGE_5</id> <!-- The local reference to be used in the game-->
            <trigger>AHighScoreAward</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-showtime-squirrel_50</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>badge-five</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[A High Scored Award]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Earn 40,000 points.]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-showtime-squirrel_50.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-showtime-squirrel_50_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement>
		<achievement>
			<id>TROPHY</id> <!-- The local reference to be used in the game-->
            <trigger>AholdOfTheGold</trigger> <!-- the actual trigger value that is sent to nick.com servers-->
            <serverCode>spongebob-squarepants-showtime-squirrel_100</serverCode><!-- This is the code that the server responds with. Needed to verify that a badge has been earned. -->
            <nickPointEventName>trophy</nickPointEventName> <!-- This will normally be: badge-one, badge-two, badge-three, badge-four, badge-five, trophy -->
            <title><![CDATA[Ahold of the Gold]]></title> <!-- The title of the achievement for in-game display. -->
            <description><![CDATA[Collect 35 trophies, in one game.]]></description> <!-- The description of the achievement for in-game display. -->
            <dataType>Number</dataType> <!-- The type of data  that will be sent with this achievement. Can be either Number or String.  -->
            <urlIconEnabled>spongebob-squarepants-showtime-squirrel_100.png</urlIconEnabled> <!-- The URL of this achievement's "earned" icon -->
            <urlIconDisabled>spongebob-squarepants-showtime-squirrel_100_grey.png</urlIconDisabled> <!-- The URL of this achievement's "not earned yet" icon -->    
		</achievement>  
	</achievements>
</config>